{
  "recordingId": 1003,
  "scenario": "COUPLE_CONFLICT",
  "durationMs": 680000,
  "segments": [
    {"segmentId": 1, "speakerRole": "SELF", "startMs": 1000, "endMs": 6500, "content": "어제 약속 시간 바뀐 걸 왜 도착 직전에 말했어?"},
    {"segmentId": 2, "speakerRole": "PARTNER", "startMs": 7000, "endMs": 12000, "content": "회의가 길어져서 나도 정신이 없었어."},
    {"segmentId": 3, "speakerRole": "SELF", "startMs": 12500, "endMs": 19000, "content": "늦을 수는 있는데 한 줄이라도 미리 보내줬으면 덜 기다렸잖아."},
    {"segmentId": 4, "speakerRole": "PARTNER", "startMs": 19500, "endMs": 25500, "content": "보내려고 했는데 회의 끝나고 바로 택시를 잡느라 놓쳤어."},
    {"segmentId": 5, "speakerRole": "SELF", "startMs": 26000, "endMs": 32500, "content": "지난번에도 비슷했고 나는 계속 뒷순위가 된 느낌이 들어."},
    {"segmentId": 6, "speakerRole": "PARTNER", "startMs": 33000, "endMs": 38500, "content": "그렇게까지 말하면 내가 아무것도 신경 안 쓴 사람 같잖아."},
    {"segmentId": 7, "speakerRole": "SELF", "startMs": 39000, "endMs": 46000, "content": "신경 안 쓴다고 단정하는 게 아니라 연락이 없을 때 내가 어떻게 느끼는지 말하는 거야."},
    {"segmentId": 8, "speakerRole": "PARTNER", "startMs": 46500, "endMs": 53000, "content": "나는 빨리 가는 게 먼저라고 생각했어. 연락보다 도착이 중요하다고 봤고."},
    {"segmentId": 9, "speakerRole": "SELF", "startMs": 53500, "endMs": 60500, "content": "늦은 것 자체가 문제라는 게 아니야. 상황을 모른 채 기다리는 게 힘들었다는 거야."},
    {"segmentId": 10, "speakerRole": "PARTNER", "startMs": 61000, "endMs": 66000, "content": "알겠어. 내가 그 차이를 제대로 생각 못 했던 것 같아."},
    {"segmentId": 11, "speakerRole": "SELF", "startMs": 66500, "endMs": 71500, "content": "나도 화나서 뒷순위라는 말을 세게 한 건 미안해."},
    {"segmentId": 12, "speakerRole": "PARTNER", "startMs": 72000, "endMs": 77000, "content": "그 말 듣고 억울해서 바로 방어적으로 말했어."},
    {"segmentId": 13, "speakerRole": "SELF", "startMs": 77500, "endMs": 82500, "content": "앞으로 일정 바뀌면 짧게라도 알려줄 수 있어?"},
    {"segmentId": 14, "speakerRole": "PARTNER", "startMs": 83000, "endMs": 89500, "content": "응. 회의 들어가기 전에 끝나는 시간 바뀔 수 있다고 먼저 보낼게."},
    {"segmentId": 15, "speakerRole": "SELF", "startMs": 90000, "endMs": 95000, "content": "정확한 시간을 몰라도 상황만 알면 괜찮아."},
    {"segmentId": 16, "speakerRole": "PARTNER", "startMs": 95500, "endMs": 101500, "content": "그리고 답이 늦으면 전화 한 번 해줘. 진동은 느낄 수도 있으니까."},
    {"segmentId": 17, "speakerRole": "SELF", "startMs": 102000, "endMs": 107500, "content": "전화하면 재촉한다고 느낄까 봐 안 했어."},
    {"segmentId": 18, "speakerRole": "PARTNER", "startMs": 108000, "endMs": 113000, "content": "한 번 정도는 괜찮아. 그건 확인으로 생각할게."},
    {"segmentId": 19, "speakerRole": "SELF", "startMs": 113500, "endMs": 119500, "content": "그럼 일정 바뀌면 먼저 메시지, 답 없으면 한 번 전화하기로 하자."},
    {"segmentId": 20, "speakerRole": "PARTNER", "startMs": 120000, "endMs": 126000, "content": "좋아. 다음에는 기다리게 해놓고 설명도 늦게 하는 일 없게 할게."},
    {"segmentId": 21, "speakerRole": "SELF", "startMs": 130000, "endMs": 142000, "content": "사실 어제는 식당에서 혼자 기다리면서 무슨 일이 생긴 건 아닌지 걱정도 했어."},
    {"segmentId": 22, "speakerRole": "PARTNER", "startMs": 145000, "endMs": 157000, "content": "그렇게 걱정할 거라고는 생각 못 했어. 그냥 내가 늦어서 화난 줄만 알았어."},
    {"segmentId": 23, "speakerRole": "SELF", "startMs": 160000, "endMs": 172000, "content": "처음에는 걱정했고 시간이 지나면서 내가 중요하지 않은 것 같아 서운해진 거야."},
    {"segmentId": 24, "speakerRole": "PARTNER", "startMs": 175000, "endMs": 187000, "content": "나는 늦더라도 결국 가고 있으니까 약속을 지키는 거라고 생각했어."},
    {"segmentId": 25, "speakerRole": "SELF", "startMs": 190000, "endMs": 202000, "content": "네가 오는 건 알지만 아무 정보 없이 기다리는 시간도 약속의 일부라고 생각해."},
    {"segmentId": 26, "speakerRole": "PARTNER", "startMs": 205000, "endMs": 217000, "content": "듣고 보니 이해돼. 나는 결과만 생각했고 네가 기다리는 과정은 놓쳤네."},
    {"segmentId": 27, "speakerRole": "SELF", "startMs": 220000, "endMs": 232000, "content": "그걸 알아줬으면 됐어. 나도 네가 일부러 그런 건 아니란 걸 알아."},
    {"segmentId": 28, "speakerRole": "PARTNER", "startMs": 235000, "endMs": 247000, "content": "그런데 지난번 일을 같이 꺼냈을 때는 내가 계속 실패한 사람처럼 느껴져서 힘들었어."},
    {"segmentId": 29, "speakerRole": "SELF", "startMs": 250000, "endMs": 262000, "content": "반복된다는 걸 설명하려고 한 건데 공격처럼 들렸구나. 그 부분은 미안해."},
    {"segmentId": 30, "speakerRole": "PARTNER", "startMs": 265000, "endMs": 277000, "content": "응. 어제 일만 말했으면 바로 사과했을 텐데 지난번 얘기까지 나오니 억울했어."},
    {"segmentId": 31, "speakerRole": "SELF", "startMs": 280000, "endMs": 292000, "content": "그럼 다음에는 과거 일을 쌓아뒀다가 한꺼번에 말하지 않고 그때그때 이야기할게."},
    {"segmentId": 32, "speakerRole": "PARTNER", "startMs": 295000, "endMs": 307000, "content": "나도 네가 문제를 꺼냈을 때 변명부터 하지 않고 먼저 어떤 점이 힘들었는지 물어볼게."},
    {"segmentId": 33, "speakerRole": "SELF", "startMs": 310000, "endMs": 322000, "content": "어제 내가 메시지로 됐어 그냥 오지 마라고 보낸 것도 너무 세게 말한 거였어."},
    {"segmentId": 34, "speakerRole": "PARTNER", "startMs": 325000, "endMs": 337000, "content": "그 메시지를 보고 정말 가지 말라는 뜻인지 화났다는 뜻인지 헷갈렸어."},
    {"segmentId": 35, "speakerRole": "SELF", "startMs": 340000, "endMs": 352000, "content": "화났다는 뜻이었어. 진짜로 오지 않길 바란 건 아니었는데 표현이 잘못됐어."},
    {"segmentId": 36, "speakerRole": "PARTNER", "startMs": 355000, "endMs": 367000, "content": "다음에는 그런 말 대신 지금 너무 서운하다고 그대로 말해주면 좋겠어."},
    {"segmentId": 37, "speakerRole": "SELF", "startMs": 370000, "endMs": 382000, "content": "알겠어. 감정을 알아맞히게 하지 말고 내가 정확히 말해볼게."},
    {"segmentId": 38, "speakerRole": "PARTNER", "startMs": 385000, "endMs": 397000, "content": "나도 바쁘다는 이유로 짧은 연락조차 못 한다고 단정하지 않을게."},
    {"segmentId": 39, "speakerRole": "SELF", "startMs": 400000, "endMs": 412000, "content": "회의 중에는 연락 못 하는 거 이해해. 시작 전에 상황이 달라졌다는 말만 있으면 돼."},
    {"segmentId": 40, "speakerRole": "PARTNER", "startMs": 415000, "endMs": 427000, "content": "예를 들어 회의가 길어질 수 있어, 끝나고 다시 연락할게 정도면 되는 거지?"},
    {"segmentId": 41, "speakerRole": "SELF", "startMs": 430000, "endMs": 442000, "content": "응, 그 정도면 나도 먼저 밥을 먹거나 다른 일을 하면서 기다릴 수 있어."},
    {"segmentId": 42, "speakerRole": "PARTNER", "startMs": 445000, "endMs": 457000, "content": "그리고 한 시간 이상 늦어질 것 같으면 약속을 미룰지 네게 먼저 물어볼게."},
    {"segmentId": 43, "speakerRole": "SELF", "startMs": 460000, "endMs": 472000, "content": "좋아. 무조건 와야 한다고 생각하지 말고 그날 상황에 맞게 다시 정하자."},
    {"segmentId": 44, "speakerRole": "PARTNER", "startMs": 475000, "endMs": 487000, "content": "어제는 네가 오래 기다렸는데도 도착해서 내가 피곤한 티만 내서 미안해."},
    {"segmentId": 45, "speakerRole": "SELF", "startMs": 490000, "endMs": 502000, "content": "나도 네가 오자마자 이유를 듣지 않고 따지기부터 해서 미안해."},
    {"segmentId": 46, "speakerRole": "PARTNER", "startMs": 505000, "endMs": 517000, "content": "우리 둘 다 여유가 없어서 말이 더 날카로워졌던 것 같아."},
    {"segmentId": 47, "speakerRole": "SELF", "startMs": 520000, "endMs": 532000, "content": "맞아. 다음에는 만나자마자 싸우기 전에 각자 십 분만 진정하는 것도 좋겠다."},
    {"segmentId": 48, "speakerRole": "PARTNER", "startMs": 535000, "endMs": 547000, "content": "십 분 쉬고 나서 지금 이야기할 수 있는지 서로 물어보는 걸로 하자."},
    {"segmentId": 49, "speakerRole": "SELF", "startMs": 550000, "endMs": 562000, "content": "좋아. 다만 아무 말 없이 피하는 걸로 느껴지지 않게 언제 이야기할지는 정해줘."},
    {"segmentId": 50, "speakerRole": "PARTNER", "startMs": 565000, "endMs": 577000, "content": "알겠어. 지금은 힘드니 십 분 뒤에 얘기하자고 분명히 말할게."},
    {"segmentId": 51, "speakerRole": "SELF", "startMs": 580000, "endMs": 592000, "content": "이렇게 차분하게 말하니까 어제 왜 그렇게 엇갈렸는지 알 것 같아."},
    {"segmentId": 52, "speakerRole": "PARTNER", "startMs": 595000, "endMs": 607000, "content": "나도 네가 단순히 시간에 예민한 게 아니라 불안하고 서운했던 거라는 걸 알겠어."},
    {"segmentId": 53, "speakerRole": "SELF", "startMs": 610000, "endMs": 622000, "content": "응. 네가 내 마음을 이해해준다고 하니까 화가 많이 풀렸어."},
    {"segmentId": 54, "speakerRole": "PARTNER", "startMs": 625000, "endMs": 637000, "content": "앞으로는 빨리 도착하는 것만큼 중간에 알려주는 것도 약속이라고 생각할게."},
    {"segmentId": 55, "speakerRole": "SELF", "startMs": 640000, "endMs": 652000, "content": "나도 서운할 때 상대 마음을 단정하지 않고 지금 상황부터 물어볼게."},
    {"segmentId": 56, "speakerRole": "PARTNER", "startMs": 655000, "endMs": 667000, "content": "고마워. 어제 일은 여기까지 정리하고 오늘 저녁은 편하게 보내자."},
    {"segmentId": 57, "speakerRole": "SELF", "startMs": 669000, "endMs": 678000, "content": "응. 이야기 피하지 않고 끝까지 들어줘서 고마워."}
  ]
}
