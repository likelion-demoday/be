{
  "recordingId": 1004,
  "scenario": "PARENT_CHILD_CONFLICT",
  "durationMs": 680000,
  "segments": [
    {"segmentId": 1, "speakerRole": "PARENT", "startMs": 1000, "endMs": 7000, "content": "어제 열한 시가 넘었는데 연락이 없어서 정말 걱정했어."},
    {"segmentId": 2, "speakerRole": "CHILD", "startMs": 7500, "endMs": 13500, "content": "버스를 놓쳤고 휴대폰 배터리도 거의 없어서 연락을 못 했어."},
    {"segmentId": 3, "speakerRole": "PARENT", "startMs": 14000, "endMs": 19500, "content": "늦어질 수는 있지만 짧게라도 알려줘야 하는 거 아니야?"},
    {"segmentId": 4, "speakerRole": "CHILD", "startMs": 20000, "endMs": 26000, "content": "친구들 앞에서 계속 휴대폰 확인하면 나만 통제받는 것 같아."},
    {"segmentId": 5, "speakerRole": "PARENT", "startMs": 26500, "endMs": 33000, "content": "통제하려는 게 아니라 사고가 난 건 아닌지 걱정되는 거야."},
    {"segmentId": 6, "speakerRole": "CHILD", "startMs": 33500, "endMs": 39000, "content": "그런데 전화가 여러 번 오면 친구들이 또 부모님이냐고 물어봐."},
    {"segmentId": 7, "speakerRole": "PARENT", "startMs": 39500, "endMs": 45500, "content": "친구를 만나지 말라는 게 아니야. 늦는다는 사실만 알고 싶은 거야."},
    {"segmentId": 8, "speakerRole": "CHILD", "startMs": 46000, "endMs": 52000, "content": "나도 늦으려고 한 건 아니고 버스 시간이 바뀐 걸 몰랐어."},
    {"segmentId": 9, "speakerRole": "PARENT", "startMs": 52500, "endMs": 58500, "content": "그 상황은 이해해. 그래도 배터리가 없기 전에 메시지를 보낼 수 있었잖아."},
    {"segmentId": 10, "speakerRole": "CHILD", "startMs": 59000, "endMs": 64500, "content": "그건 맞아. 다음에는 배터리 적을 때 먼저 말할게."},
    {"segmentId": 11, "speakerRole": "PARENT", "startMs": 65000, "endMs": 70500, "content": "몇 시쯤 들어올지만 알면 계속 전화하지 않을게."},
    {"segmentId": 12, "speakerRole": "CHILD", "startMs": 71000, "endMs": 76500, "content": "정확한 시간은 모르더라도 예상 시간 보내면 돼?"},
    {"segmentId": 13, "speakerRole": "PARENT", "startMs": 77000, "endMs": 82000, "content": "응, 바뀌면 한 번만 다시 알려주면 돼."},
    {"segmentId": 14, "speakerRole": "CHILD", "startMs": 82500, "endMs": 88500, "content": "그러면 계속 전화하지 말고 메시지 답을 조금 기다려줘."},
    {"segmentId": 15, "speakerRole": "PARENT", "startMs": 89000, "endMs": 95000, "content": "알겠어. 한 시간 동안 답이 없을 때만 전화하는 건 어때?"},
    {"segmentId": 16, "speakerRole": "CHILD", "startMs": 95500, "endMs": 100500, "content": "한 시간은 너무 길고 삼십 분이면 괜찮을 것 같아."},
    {"segmentId": 17, "speakerRole": "PARENT", "startMs": 101000, "endMs": 106000, "content": "좋아. 삼십 분 동안 답이 없으면 한 번 전화할게."},
    {"segmentId": 18, "speakerRole": "CHILD", "startMs": 106500, "endMs": 111500, "content": "나도 늦어지면 먼저 예상 시간 보낼게."},
    {"segmentId": 19, "speakerRole": "PARENT", "startMs": 112000, "endMs": 117500, "content": "화내려고 한 게 아니라 무사한지 알고 싶었던 거야."},
    {"segmentId": 20, "speakerRole": "CHILD", "startMs": 118000, "endMs": 123500, "content": "알아. 나도 걱정한 건 이해하는데 말투가 무서웠어."},
    {"segmentId": 21, "speakerRole": "PARENT", "startMs": 128000, "endMs": 140000, "content": "현관에 들어오자마자 소리부터 높인 건 미안해. 많이 걱정해서 감정이 앞섰어."},
    {"segmentId": 22, "speakerRole": "CHILD", "startMs": 143000, "endMs": 155000, "content": "이유를 설명하려는데 계속 변명하지 말라고 해서 아무 말도 하기 싫어졌어."},
    {"segmentId": 23, "speakerRole": "PARENT", "startMs": 158000, "endMs": 170000, "content": "그때는 설명을 들을 여유가 없었어. 다음에는 먼저 무슨 일이 있었는지 물어볼게."},
    {"segmentId": 24, "speakerRole": "CHILD", "startMs": 173000, "endMs": 185000, "content": "나도 문을 세게 닫고 방에 들어간 건 미안해. 더 싸우기 싫어서 피한 거였어."},
    {"segmentId": 25, "speakerRole": "PARENT", "startMs": 188000, "endMs": 200000, "content": "잠깐 혼자 있고 싶다고 말했으면 기다렸을 텐데 문을 닫으니 더 화가 났어."},
    {"segmentId": 26, "speakerRole": "CHILD", "startMs": 203000, "endMs": 215000, "content": "다음에는 지금 말하면 더 화낼 것 같으니 십 분만 있다가 얘기하자고 할게."},
    {"segmentId": 27, "speakerRole": "PARENT", "startMs": 218000, "endMs": 230000, "content": "좋아. 대신 언제 다시 이야기할지 말해주면 도망가는 거라고 생각하지 않을게."},
    {"segmentId": 28, "speakerRole": "CHILD", "startMs": 233000, "endMs": 245000, "content": "그리고 친구들 이름이나 부모님 번호까지 매번 물어보는 건 부담스러워."},
    {"segmentId": 29, "speakerRole": "PARENT", "startMs": 248000, "endMs": 260000, "content": "누구와 어디에 있는지는 알아야 한다고 생각했는데 어느 정도가 부담스러운 거야?"},
    {"segmentId": 30, "speakerRole": "CHILD", "startMs": 263000, "endMs": 275000, "content": "어느 동네에서 누구랑 있는지만 말할게. 친구 연락처까지 확인하는 건 싫어."},
    {"segmentId": 31, "speakerRole": "PARENT", "startMs": 278000, "endMs": 290000, "content": "평소에는 그렇게 하고 아주 늦거나 멀리 갈 때만 자세히 알려주는 건 어때?"},
    {"segmentId": 32, "speakerRole": "CHILD", "startMs": 293000, "endMs": 305000, "content": "그건 괜찮아. 다른 지역에 가거나 자정이 넘으면 먼저 더 자세히 말할게."},
    {"segmentId": 33, "speakerRole": "PARENT", "startMs": 308000, "endMs": 320000, "content": "평일 귀가 시간은 지금처럼 열 시로 하고 주말은 조금 늦춰달라는 거지?"},
    {"segmentId": 34, "speakerRole": "CHILD", "startMs": 323000, "endMs": 335000, "content": "응. 주말에는 버스가 끊기기 전인 열한 시 반까지는 괜찮았으면 좋겠어."},
    {"segmentId": 35, "speakerRole": "PARENT", "startMs": 338000, "endMs": 350000, "content": "처음부터 열한 시 반은 걱정돼. 한 달 동안 열한 시로 해보고 다시 얘기하면 어때?"},
    {"segmentId": 36, "speakerRole": "CHILD", "startMs": 353000, "endMs": 365000, "content": "한 달 동안 연락 약속도 잘 지키면 그다음에는 열한 시 반으로 늘려주는 거야?"},
    {"segmentId": 37, "speakerRole": "PARENT", "startMs": 368000, "endMs": 380000, "content": "응. 늦을 때 미리 연락하고 정한 시간에 들어오면 다시 조정할 수 있어."},
    {"segmentId": 38, "speakerRole": "CHILD", "startMs": 383000, "endMs": 395000, "content": "알겠어. 감시받는 조건이 아니라 신뢰를 보여주는 기간이라고 생각해볼게."},
    {"segmentId": 39, "speakerRole": "PARENT", "startMs": 398000, "endMs": 410000, "content": "나도 네가 스스로 약속을 지키는 걸 보면 전화 횟수를 줄일 수 있을 것 같아."},
    {"segmentId": 40, "speakerRole": "CHILD", "startMs": 413000, "endMs": 425000, "content": "배터리가 없었던 건 진짜였어. 앞으로 작은 보조 배터리를 가방에 넣어둘게."},
    {"segmentId": 41, "speakerRole": "PARENT", "startMs": 428000, "endMs": 440000, "content": "집에 여분이 있으니 그걸 가져가. 충전은 네가 챙기는 걸로 하자."},
    {"segmentId": 42, "speakerRole": "CHILD", "startMs": 443000, "endMs": 455000, "content": "응. 배터리가 십 퍼센트 아래로 내려가면 먼저 예상 시간을 보낼게."},
    {"segmentId": 43, "speakerRole": "PARENT", "startMs": 458000, "endMs": 470000, "content": "내가 계속 전화했던 건 예전에 네가 다쳐서 연락 왔던 일이 생각나서 그랬어."},
    {"segmentId": 44, "speakerRole": "CHILD", "startMs": 473000, "endMs": 485000, "content": "그때 일 때문에 더 걱정하는 건 알지만 매번 같은 사고가 나는 건 아니잖아."},
    {"segmentId": 45, "speakerRole": "PARENT", "startMs": 488000, "endMs": 500000, "content": "맞아. 걱정된다고 해서 항상 최악의 상황부터 생각하지 않도록 해볼게."},
    {"segmentId": 46, "speakerRole": "CHILD", "startMs": 503000, "endMs": 515000, "content": "나도 연락을 귀찮은 검사라고만 생각하지 않고 무사하다는 확인이라고 생각할게."},
    {"segmentId": 47, "speakerRole": "PARENT", "startMs": 518000, "endMs": 530000, "content": "친구들 앞에서 전화받기 곤란하면 짧게 이모티콘 하나만 보내도 괜찮아."},
    {"segmentId": 48, "speakerRole": "CHILD", "startMs": 533000, "endMs": 545000, "content": "그건 편할 것 같아. 확인했다는 표시를 보내고 자세한 건 나중에 말할게."},
    {"segmentId": 49, "speakerRole": "PARENT", "startMs": 548000, "endMs": 560000, "content": "이번 주 토요일에도 그 친구들이랑 만나는 거야?"},
    {"segmentId": 50, "speakerRole": "CHILD", "startMs": 563000, "endMs": 575000, "content": "응. 시험 끝나서 영화 보고 저녁 먹기로 했어. 집 근처 영화관이야."},
    {"segmentId": 51, "speakerRole": "PARENT", "startMs": 578000, "endMs": 590000, "content": "그러면 열 시 반쯤 끝날 것 같은데 열한 시까지 들어오는 걸로 하면 되겠네."},
    {"segmentId": 52, "speakerRole": "CHILD", "startMs": 593000, "endMs": 605000, "content": "응. 영화 끝나고 출발할 때 메시지 보내고 버스 놓치면 바로 다시 말할게."},
    {"segmentId": 53, "speakerRole": "PARENT", "startMs": 608000, "endMs": 620000, "content": "좋아. 나는 메시지 보낸 뒤 삼십 분은 기다리고 그동안 전화하지 않을게."},
    {"segmentId": 54, "speakerRole": "CHILD", "startMs": 623000, "endMs": 635000, "content": "그렇게 해주면 나도 친구들 앞에서 계속 눈치 보지 않고 먼저 연락할 수 있어."},
    {"segmentId": 55, "speakerRole": "PARENT", "startMs": 638000, "endMs": 650000, "content": "어제는 서로 많이 화났지만 오늘 이렇게 규칙을 같이 정해서 다행이야."},
    {"segmentId": 56, "speakerRole": "CHILD", "startMs": 653000, "endMs": 665000, "content": "나도 그냥 혼날 줄 알았는데 내 얘기도 들어줘서 고마워."},
    {"segmentId": 57, "speakerRole": "PARENT", "startMs": 668000, "endMs": 678000, "content": "앞으로도 불편한 게 있으면 문을 닫기 전에 먼저 말해줘."}
  ]
}
