{
  "recordingId": 1901,
  "scenario": "FRIEND_DAILY",
  "durationMs": 600000,
  "speakers": [
    {"speakerRole": "SELF", "speakerName": "민준"},
    {"speakerRole": "FRIEND", "speakerName": "도윤"}
  ],
  "segments": [
    {"segmentId": 1, "speakerRole": "SELF", "startMs": 1000, "endMs": 10000, "content": "야 어제 티켓팅 존나 빡셀 줄 알았는데 너 성공했다며"},
    {"segmentId": 2, "speakerRole": "FRIEND", "startMs": 12500, "endMs": 22000, "content": "어 존나 떨면서 새로고침했는데 갑자기 앞자리가 뜨는 거야"},
    {"segmentId": 3, "speakerRole": "SELF", "startMs": 24500, "endMs": 34000, "content": "와 그걸 잡았다고 너 손 진짜 빠르네 몇 열이야"},
    {"segmentId": 4, "speakerRole": "FRIEND", "startMs": 36500, "endMs": 46000, "content": "십이 열인데 중앙 쪽이야 화면 보자마자 그냥 눌렀어"},
    {"segmentId": 5, "speakerRole": "SELF", "startMs": 48500, "endMs": 58000, "content": "그 정도면 무대 잘 보이겠다 나 벌써 신나는데"},
    {"segmentId": 6, "speakerRole": "FRIEND", "startMs": 60500, "endMs": 70000, "content": "근데 결제창에서 카드 인증 떠서 심장 멎는 줄 알았잖아"},
    {"segmentId": 7, "speakerRole": "SELF", "startMs": 72500, "endMs": 82000, "content": "시발 거기서 튕겼으면 오늘 하루 종일 울었다 진짜"},
    {"segmentId": 8, "speakerRole": "FRIEND", "startMs": 84500, "endMs": 94000, "content": "내가 그래서 손 떨면서도 카드 번호 두 번 확인했지"},
    {"segmentId": 9, "speakerRole": "SELF", "startMs": 96500, "endMs": 106000, "content": "아무튼 네 덕분에 간다 밥은 내가 제대로 살게"},
    {"segmentId": 10, "speakerRole": "FRIEND", "startMs": 108500, "endMs": 118000, "content": "시발 말만 하지 말고 이번엔 진짜 비싼 거 사라"},

    {"segmentId": 11, "speakerRole": "SELF", "startMs": 120500, "endMs": 130000, "content": "오케이 공연 전에 그 성수 신상 카페 먼저 갈래"},
    {"segmentId": 12, "speakerRole": "FRIEND", "startMs": 132500, "endMs": 142000, "content": "거기 요즘 영상에 계속 뜨던데 웨이팅 심하지 않아"},
    {"segmentId": 13, "speakerRole": "SELF", "startMs": 144500, "endMs": 154000, "content": "디저트 비주얼이 존나 예쁘긴 하더라 사진은 잘 나올 듯"},
    {"segmentId": 14, "speakerRole": "FRIEND", "startMs": 156500, "endMs": 166000, "content": "너 또 사진 백 장 찍고 한 장 고르는 거 아니냐"},
    {"segmentId": 15, "speakerRole": "SELF", "startMs": 168500, "endMs": 178000, "content": "아 이번엔 빠르게 찍을게 너 배고프게 안 한다니까"},
    {"segmentId": 16, "speakerRole": "FRIEND", "startMs": 180500, "endMs": 190000, "content": "그 말을 작년부터 들었는데 아직 한 번도 못 지켰잖아"},
    {"segmentId": 17, "speakerRole": "SELF", "startMs": 192500, "endMs": 202000, "content": "인정 대신 크림빵이랑 푸딩 둘 다 시켜줄게"},
    {"segmentId": 18, "speakerRole": "FRIEND", "startMs": 204500, "endMs": 214000, "content": "그 집 푸딩 존나 맛있다던데 그럼 바로 용서 가능"},
    {"segmentId": 19, "speakerRole": "SELF", "startMs": 216500, "endMs": 226000, "content": "너는 진짜 먹을 걸로 협상하면 세상 쉬운 인간이야"},
    {"segmentId": 20, "speakerRole": "FRIEND", "startMs": 228500, "endMs": 238000, "content": "친구가 단순해야 네 인생도 편한 거다 감사해라"},

    {"segmentId": 21, "speakerRole": "SELF", "startMs": 240500, "endMs": 250000, "content": "근데 지난번에 말한 소개팅은 결국 어떻게 됐냐"},
    {"segmentId": 22, "speakerRole": "FRIEND", "startMs": 252500, "endMs": 262000, "content": "두 시간 정도 얘기했는데 생각보다 대화가 잘 통했어"},
    {"segmentId": 23, "speakerRole": "SELF", "startMs": 264500, "endMs": 274000, "content": "씨발 두 시간이나 있었다고 이거 완전 긍정 신호인데"},
    {"segmentId": 24, "speakerRole": "FRIEND", "startMs": 276500, "endMs": 286000, "content": "씨발 아직 한 번 본 건데 혼자 드라마 쓰지 좀 마"},
    {"segmentId": 25, "speakerRole": "SELF", "startMs": 288500, "endMs": 298000, "content": "아니 그래도 웃으면서 다음에 또 보자고 했다며"},
    {"segmentId": 26, "speakerRole": "FRIEND", "startMs": 300500, "endMs": 310000, "content": "응 이번 주에 전시 보자고 연락은 왔어 나도 가려고"},
    {"segmentId": 27, "speakerRole": "SELF", "startMs": 312500, "endMs": 322000, "content": "오 분위기 좋네 옷 뭐 입을지도 이미 골랐지"},
    {"segmentId": 28, "speakerRole": "FRIEND", "startMs": 324500, "endMs": 334000, "content": "검은 셔츠 입으려고 했는데 너무 꾸민 티 나나"},
    {"segmentId": 29, "speakerRole": "SELF", "startMs": 336500, "endMs": 346000, "content": "그냥 입어 너 맨투맨보다 백 배 낫고 사진도 보내봐"},
    {"segmentId": 30, "speakerRole": "FRIEND", "startMs": 348500, "endMs": 358000, "content": "알았어 시바 너한테 패션 검사를 다 받게 되네"},

    {"segmentId": 31, "speakerRole": "SELF", "startMs": 360500, "endMs": 370000, "content": "어제 게임은 존나 아깝더라 마지막 한 판만 이겼으면 승급인데"},
    {"segmentId": 32, "speakerRole": "FRIEND", "startMs": 372500, "endMs": 382000, "content": "네가 마지막에 혼자 들어가지만 않았어도 가능했어"},
    {"segmentId": 33, "speakerRole": "SELF", "startMs": 384500, "endMs": 394000, "content": "뒤에서 다 따라오는 줄 알았지 나만 신난 사람이 됐네"},
    {"segmentId": 34, "speakerRole": "FRIEND", "startMs": 396500, "endMs": 406000, "content": "존나 당당하게 들어가길래 무슨 계획 있는 줄 알았음"},
    {"segmentId": 35, "speakerRole": "SELF", "startMs": 408500, "endMs": 418000, "content": "계획은 있었는데 실력이 계획을 못 따라갔다 인정한다"},
    {"segmentId": 36, "speakerRole": "FRIEND", "startMs": 420500, "endMs": 430000, "content": "그래도 오늘 다시 하면 올라갈 수 있을 것 같긴 해"},
    {"segmentId": 37, "speakerRole": "SELF", "startMs": 432500, "endMs": 442000, "content": "열한 시쯤 접속 가능해 이번에는 말 잘 듣고 할게"},
    {"segmentId": 38, "speakerRole": "FRIEND", "startMs": 444500, "endMs": 454000, "content": "좋아 들어가기 전에 마이크부터 확인하고 와라"},
    {"segmentId": 39, "speakerRole": "SELF", "startMs": 456500, "endMs": 466000, "content": "존나 진지하게 한다 오늘은 절대 먼저 안 들어감"},
    {"segmentId": 40, "speakerRole": "FRIEND", "startMs": 468500, "endMs": 478000, "content": "그 말 녹음해둔다 또 혼자 가면 바로 재생할 거야"},

    {"segmentId": 41, "speakerRole": "SELF", "startMs": 480500, "endMs": 490000, "content": "아 그리고 다음 달 부산 여행 숙소 봤어"},
    {"segmentId": 42, "speakerRole": "FRIEND", "startMs": 492500, "endMs": 502000, "content": "봤는데 바다 보이는 방은 가격이 존나 세더라"},
    {"segmentId": 43, "speakerRole": "SELF", "startMs": 504500, "endMs": 514000, "content": "미친 주말이라고 거의 두 배 받는 건 너무하네"},
    {"segmentId": 44, "speakerRole": "FRIEND", "startMs": 516500, "endMs": 526000, "content": "미친 가격이긴 한데 넷이 나누면 한 번쯤은 가능하지 않을까"},
    {"segmentId": 45, "speakerRole": "SELF", "startMs": 528500, "endMs": 538000, "content": "그러면 위치 좋은 데로 잡자 새벽에 바다도 보러 가게"},
    {"segmentId": 46, "speakerRole": "FRIEND", "startMs": 540500, "endMs": 550000, "content": "너 새벽에 절대 못 일어나잖아 내가 깨우면 화내지 마라"},
    {"segmentId": 47, "speakerRole": "SELF", "startMs": 552500, "endMs": 562000, "content": "이번 여행은 존나 알차게 놀 거라서 무조건 일어난다"},
    {"segmentId": 48, "speakerRole": "FRIEND", "startMs": 564500, "endMs": 574000, "content": "씨바 지난번에도 똑같이 말하고 점심까지 잔 사람이 누구더라"},
    {"segmentId": 49, "speakerRole": "SELF", "startMs": 576500, "endMs": 586000, "content": "과거의 나는 잊어줘 이번에는 알람 다섯 개 맞출게"},
    {"segmentId": 50, "speakerRole": "FRIEND", "startMs": 588500, "endMs": 598000, "content": "오케이 티켓이랑 숙소는 내가 볼 테니까 너는 맛집 리스트 맡아"}
  ]
}
