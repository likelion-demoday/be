{
  "recordingId": 1001,
  "scenario": "FRIEND_DAILY",
  "durationMs": 660000,
  "segments": [
    {"segmentId": 1, "speakerRole": "SELF", "startMs": 1000, "endMs": 6000, "content": "요즘 새로 들어간 회사는 좀 어때?"},
    {"segmentId": 2, "speakerRole": "FRIEND", "startMs": 6500, "endMs": 12500, "content": "아직 적응 중인데 팀 사람들이 생각보다 편하게 대해줘."},
    {"segmentId": 3, "speakerRole": "SELF", "startMs": 13000, "endMs": 19500, "content": "다행이다. 지난번에는 첫 회의 때문에 엄청 긴장된다고 했잖아."},
    {"segmentId": 4, "speakerRole": "FRIEND", "startMs": 20000, "endMs": 26000, "content": "맞아, 근데 막상 들어가니까 다들 커피 얘기만 하더라."},
    {"segmentId": 5, "speakerRole": "SELF", "startMs": 26500, "endMs": 31000, "content": "회의보다 원두 고르는 게 더 중요한 팀이네."},
    {"segmentId": 6, "speakerRole": "FRIEND", "startMs": 31500, "endMs": 36500, "content": "진짜 그래. 점심 먹고 카페 투어까지 갔어."},
    {"segmentId": 7, "speakerRole": "SELF", "startMs": 37000, "endMs": 42500, "content": "너 원래 산미 있는 커피 싫어하지 않았어?"},
    {"segmentId": 8, "speakerRole": "FRIEND", "startMs": 43000, "endMs": 49500, "content": "싫어했는데 이번에 마신 건 괜찮았어. 이름은 기억 안 나."},
    {"segmentId": 9, "speakerRole": "SELF", "startMs": 50000, "endMs": 56500, "content": "다음에 나도 데려가 줘. 요즘 회사 근처 카페가 다 질렸어."},
    {"segmentId": 10, "speakerRole": "FRIEND", "startMs": 57000, "endMs": 61500, "content": "좋지. 대신 네가 말한 치킨집도 가자."},
    {"segmentId": 11, "speakerRole": "SELF", "startMs": 62000, "endMs": 67500, "content": "거기는 금요일 저녁에 줄이 길어서 일찍 가야 해."},
    {"segmentId": 12, "speakerRole": "FRIEND", "startMs": 68000, "endMs": 74500, "content": "그럼 퇴근하자마자 만나서 치킨 먹고 카페 가면 되겠다."},
    {"segmentId": 13, "speakerRole": "SELF", "startMs": 75000, "endMs": 79000, "content": "먹는 일정만 너무 완벽한데?"},
    {"segmentId": 14, "speakerRole": "FRIEND", "startMs": 79500, "endMs": 84500, "content": "우리 만나면 원래 먹는 얘기가 절반이잖아."},
    {"segmentId": 15, "speakerRole": "SELF", "startMs": 85000, "endMs": 90500, "content": "인정. 다음 주 금요일 여섯 시 반 괜찮아?"},
    {"segmentId": 16, "speakerRole": "FRIEND", "startMs": 91000, "endMs": 96000, "content": "응, 그날은 야근만 없으면 괜찮아."},
    {"segmentId": 17, "speakerRole": "SELF", "startMs": 96500, "endMs": 102500, "content": "야근 생기면 미리 말해줘. 예약은 내가 해둘게."},
    {"segmentId": 18, "speakerRole": "FRIEND", "startMs": 103000, "endMs": 108000, "content": "오케이, 이번에는 내가 커피 살게."},
    {"segmentId": 19, "speakerRole": "SELF", "startMs": 112000, "endMs": 121000, "content": "그나저나 새 회사에서는 지금 어떤 업무 맡고 있어? 전에 하던 일이랑 비슷해?"},
    {"segmentId": 20, "speakerRole": "FRIEND", "startMs": 123000, "endMs": 134000, "content": "기획 쪽인 건 같은데 이번에는 사용자 인터뷰도 직접 해야 해서 조금 낯설어."},
    {"segmentId": 21, "speakerRole": "SELF", "startMs": 136000, "endMs": 146000, "content": "너 사람들 얘기 듣고 정리하는 거 좋아하니까 잘 맞을 것 같은데."},
    {"segmentId": 22, "speakerRole": "FRIEND", "startMs": 148000, "endMs": 159000, "content": "듣는 건 좋은데 처음 보는 사람 앞에서 질문을 이어가는 게 어렵더라."},
    {"segmentId": 23, "speakerRole": "SELF", "startMs": 161000, "endMs": 172000, "content": "처음부터 잘할 필요는 없지. 옆에서 같이 들어가는 선배는 있어?"},
    {"segmentId": 24, "speakerRole": "FRIEND", "startMs": 174000, "endMs": 186000, "content": "응, 처음 두 번은 선배가 같이 들어가기로 했고 전혀 부담 주는 분위기는 아니었어."},
    {"segmentId": 25, "speakerRole": "SELF", "startMs": 188000, "endMs": 199000, "content": "그럼 다행이네. 끝나고 네가 놓친 질문만 한번 확인해 달라고 하면 되겠다."},
    {"segmentId": 26, "speakerRole": "FRIEND", "startMs": 201000, "endMs": 212000, "content": "맞아, 팀장도 일단 해보고 피드백 받는 방식으로 가자고 했어."},
    {"segmentId": 27, "speakerRole": "SELF", "startMs": 214000, "endMs": 224000, "content": "이전 회사보다 배우기는 좋겠다. 출퇴근 시간은 좀 줄었어?"},
    {"segmentId": 28, "speakerRole": "FRIEND", "startMs": 226000, "endMs": 238000, "content": "십 분 정도 줄었는데 환승을 한 번 더 해서 체감상 비슷해. 그래도 앉아 갈 때가 많아."},
    {"segmentId": 29, "speakerRole": "SELF", "startMs": 242000, "endMs": 252000, "content": "요즘 아침마다 뛴다고 했는데 출근 전에 계속 하고 있어?"},
    {"segmentId": 30, "speakerRole": "FRIEND", "startMs": 254000, "endMs": 266000, "content": "매일은 못 하고 일주일에 세 번 정도 해. 알람 끄고 다시 잔 날도 많고."},
    {"segmentId": 31, "speakerRole": "SELF", "startMs": 268000, "endMs": 277000, "content": "세 번이면 충분하지. 갑자기 매일 하면 금방 지칠걸."},
    {"segmentId": 32, "speakerRole": "FRIEND", "startMs": 279000, "endMs": 290000, "content": "속도를 천천히 해서 그런지 무릎은 안 아파. 대신 종아리가 좀 당겨."},
    {"segmentId": 33, "speakerRole": "SELF", "startMs": 292000, "endMs": 303000, "content": "전에 내가 보내준 스트레칭 영상 해봤어? 뛰고 바로 앉으면 더 뻐근해."},
    {"segmentId": 34, "speakerRole": "FRIEND", "startMs": 305000, "endMs": 316000, "content": "한 번 해봤는데 자세가 웃겨서 혼자 하다가 민망해졌어."},
    {"segmentId": 35, "speakerRole": "SELF", "startMs": 318000, "endMs": 327000, "content": "집에서 혼자 하는데 누구한테 민망한 건데?"},
    {"segmentId": 36, "speakerRole": "FRIEND", "startMs": 329000, "endMs": 340000, "content": "거울 속의 나한테. 내가 생각한 운동인의 모습이 아니더라고."},
    {"segmentId": 37, "speakerRole": "SELF", "startMs": 342000, "endMs": 352000, "content": "장비부터 산 사람답게 상상 속 모습은 이미 국가대표였구나."},
    {"segmentId": 38, "speakerRole": "FRIEND", "startMs": 354000, "endMs": 364000, "content": "신발 산 돈이 아까워서라도 계속 뛸 거야. 너도 같이 뛸래?"},
    {"segmentId": 39, "speakerRole": "SELF", "startMs": 366000, "endMs": 376000, "content": "나는 뛰는 건 싫고 끝나고 먹는 아침 메뉴는 같이할 수 있어."},
    {"segmentId": 40, "speakerRole": "FRIEND", "startMs": 378000, "endMs": 388000, "content": "역시 운동보다 식사가 목적인 사람은 태도가 일관되네."},
    {"segmentId": 41, "speakerRole": "SELF", "startMs": 392000, "endMs": 403000, "content": "지난번 강릉 갔을 때도 네가 새벽에 뛰고 나는 숙소에서 잤잖아."},
    {"segmentId": 42, "speakerRole": "FRIEND", "startMs": 405000, "endMs": 416000, "content": "맞아. 일출 본다고 같이 나오더니 현관에서 다시 방으로 들어갔지."},
    {"segmentId": 43, "speakerRole": "SELF", "startMs": 418000, "endMs": 428000, "content": "그날 너무 추웠어. 대신 내가 점심 맛집은 제대로 찾았잖아."},
    {"segmentId": 44, "speakerRole": "FRIEND", "startMs": 430000, "endMs": 442000, "content": "인정해. 비도 안 왔고 사람도 적어서 그 여행은 전체적으로 좋았어."},
    {"segmentId": 45, "speakerRole": "SELF", "startMs": 444000, "endMs": 455000, "content": "사진 정리하다가 네가 바다 앞에서 모자 놓친 영상도 발견했어."},
    {"segmentId": 46, "speakerRole": "FRIEND", "startMs": 457000, "endMs": 468000, "content": "그건 지워줘. 모자 잡으러 뛰는 모습이 너무 처절했단 말이야."},
    {"segmentId": 47, "speakerRole": "SELF", "startMs": 470000, "endMs": 479000, "content": "이미 우리 단체방 최고의 영상인데 어떻게 지워."},
    {"segmentId": 48, "speakerRole": "FRIEND", "startMs": 481000, "endMs": 492000, "content": "그러면 네가 숙소 비밀번호 잊어서 당황한 영상도 같이 공개한다."},
    {"segmentId": 49, "speakerRole": "SELF", "startMs": 494000, "endMs": 505000, "content": "서로 약점 하나씩 보관하는 걸로 합의하자. 평화가 중요하니까."},
    {"segmentId": 50, "speakerRole": "FRIEND", "startMs": 507000, "endMs": 517000, "content": "좋아, 상호 확증 파괴 같은 우정이네."},
    {"segmentId": 51, "speakerRole": "SELF", "startMs": 521000, "endMs": 532000, "content": "금요일에는 혹시 너희 동생도 같이 오는 거야? 전에 그 치킨집 궁금해했잖아."},
    {"segmentId": 52, "speakerRole": "FRIEND", "startMs": 534000, "endMs": 545000, "content": "물어봤는데 그날 시험 준비해야 한다고 했어. 우리 둘만 갈 것 같아."},
    {"segmentId": 53, "speakerRole": "SELF", "startMs": 547000, "endMs": 557000, "content": "알겠어. 그러면 두 자리로 예약하고 메뉴는 가서 고르자."},
    {"segmentId": 54, "speakerRole": "FRIEND", "startMs": 559000, "endMs": 570000, "content": "매운맛은 제일 약한 단계로 하자. 지난번처럼 허세 부리지 말고."},
    {"segmentId": 55, "speakerRole": "SELF", "startMs": 572000, "endMs": 583000, "content": "이번에는 매운맛 도전 안 할게. 다음 날까지 속이 아파서 후회했어."},
    {"segmentId": 56, "speakerRole": "FRIEND", "startMs": 585000, "endMs": 596000, "content": "그 말을 녹음해 둬야겠다. 음식 앞에 가면 또 생각이 바뀔 수 있으니까."},
    {"segmentId": 57, "speakerRole": "SELF", "startMs": 598000, "endMs": 608000, "content": "내가 먼저 도착하면 창가 자리 가능한지 물어볼게."},
    {"segmentId": 58, "speakerRole": "FRIEND", "startMs": 610000, "endMs": 620000, "content": "나는 회사에서 바로 출발하고, 늦어지면 다섯 시 반 전에 연락할게."},
    {"segmentId": 59, "speakerRole": "SELF", "startMs": 622000, "endMs": 633000, "content": "좋아. 오랜만에 천천히 얘기하자. 새 회사 첫 주도 고생 많았어."},
    {"segmentId": 60, "speakerRole": "FRIEND", "startMs": 635000, "endMs": 646000, "content": "고마워. 너한테 얘기하고 나니까 긴장했던 게 조금 정리된다."}
  ]
}
