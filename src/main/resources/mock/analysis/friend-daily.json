{
  "recordingId": 1002,
  "scenario": "FRIEND_DAILY",
  "durationMs": 180000,
  "speakers": [
    {
      "speakerRole": "SELF",
      "speakerName": "호준"
    },
    {
      "speakerRole": "FRIEND",
      "speakerName": "호석"
    }
  ],
  "segments": [
    {
      "segmentId": 1,
      "speakerRole": "SELF",
      "startMs": 1000,
      "endMs": 3400,
      "content": "이번 주 여행 그거 어떻게 할 거야"
    },
    {
      "segmentId": 2,
      "speakerRole": "FRIEND",
      "startMs": 4000,
      "endMs": 7600,
      "content": "아직 숙소는 예약하지 않았어. 네 일정을 기다리고 있었어."
    },
    {
      "segmentId": 3,
      "speakerRole": "SELF",
      "startMs": 8200,
      "endMs": 10400,
      "content": "아 그게 내가 회사 때문에"
    },
    {
      "segmentId": 4,
      "speakerRole": "FRIEND",
      "startMs": 11000,
      "endMs": 13800,
      "content": "금요일에 일이 생길 수도 있다는 뜻이야?"
    },
    {
      "segmentId": 5,
      "speakerRole": "SELF",
      "startMs": 14500,
      "endMs": 16600,
      "content": "뭐 그런 것도 있고 그냥"
    },
    {
      "segmentId": 6,
      "speakerRole": "FRIEND",
      "startMs": 17300,
      "endMs": 21200,
      "content": "일정이 확실하지 않으면 토요일 아침에 출발하는 방법도 있어."
    },
    {
      "segmentId": 7,
      "speakerRole": "SELF",
      "startMs": 21900,
      "endMs": 23600,
      "content": "아니 근데 그거"
    },
    {
      "segmentId": 8,
      "speakerRole": "FRIEND",
      "startMs": 24300,
      "endMs": 27100,
      "content": "토요일에 출발하기 어려운 이유가 있어?"
    },
    {
      "segmentId": 9,
      "speakerRole": "SELF",
      "startMs": 27800,
      "endMs": 30000,
      "content": "그냥 좀 그렇잖아"
    },
    {
      "segmentId": 10,
      "speakerRole": "FRIEND",
      "startMs": 30700,
      "endMs": 34900,
      "content": "나는 이유를 잘 모르겠어. 아침에 일찍 일어나는 게 부담스러운 거야?"
    },
    {
      "segmentId": 11,
      "speakerRole": "SELF",
      "startMs": 35600,
      "endMs": 37800,
      "content": "아니 늦는 건 아닌데 약간 그"
    },
    {
      "segmentId": 12,
      "speakerRole": "FRIEND",
      "startMs": 38500,
      "endMs": 41400,
      "content": "그러면 몇 시부터 출발할 수 있는지 알려줘."
    },
    {
      "segmentId": 13,
      "speakerRole": "SELF",
      "startMs": 42100,
      "endMs": 43800,
      "content": "응 뭐"
    },
    {
      "segmentId": 14,
      "speakerRole": "FRIEND",
      "startMs": 44500,
      "endMs": 48500,
      "content": "가능한 시간을 알아야 내가 숙소와 기차를 찾아볼 수 있어."
    },
    {
      "segmentId": 15,
      "speakerRole": "SELF",
      "startMs": 49200,
      "endMs": 51800,
      "content": "일단 나중에 보고 아무튼"
    },
    {
      "segmentId": 16,
      "speakerRole": "FRIEND",
      "startMs": 52500,
      "endMs": 55600,
      "content": "오늘 저녁까지는 확인해서 알려줄 수 있어?"
    },
    {
      "segmentId": 17,
      "speakerRole": "SELF",
      "startMs": 56300,
      "endMs": 57900,
      "content": "아마도"
    },
    {
      "segmentId": 18,
      "speakerRole": "FRIEND",
      "startMs": 58600,
      "endMs": 62400,
      "content": "확정이 어렵다면 이번 주가 아니라 다음 주에 가도 괜찮아."
    },
    {
      "segmentId": 19,
      "speakerRole": "SELF",
      "startMs": 63100,
      "endMs": 65000,
      "content": "그것도 좀"
    },
    {
      "segmentId": 20,
      "speakerRole": "FRIEND",
      "startMs": 65700,
      "endMs": 69200,
      "content": "어떤 부분이 마음에 들지 않는지 설명해 줘야 같이 정할 수 있어."
    },
    {
      "segmentId": 21,
      "speakerRole": "SELF",
      "startMs": 69900,
      "endMs": 72300,
      "content": "그냥 내가 요즘 그래서"
    },
    {
      "segmentId": 22,
      "speakerRole": "FRIEND",
      "startMs": 73000,
      "endMs": 76900,
      "content": "회사 일이 많아서 여행 계획을 세우는 것 자체가 부담스러운 거야?"
    },
    {
      "segmentId": 23,
      "speakerRole": "SELF",
      "startMs": 77600,
      "endMs": 79300,
      "content": "어 약간"
    },
    {
      "segmentId": 24,
      "speakerRole": "FRIEND",
      "startMs": 80000,
      "endMs": 84300,
      "content": "그렇다면 이번에는 멀리 가지 않고 근처에서 하루만 쉬어도 괜찮을 것 같아."
    },
    {
      "segmentId": 25,
      "speakerRole": "SELF",
      "startMs": 85000,
      "endMs": 86800,
      "content": "아 그래"
    },
    {
      "segmentId": 26,
      "speakerRole": "FRIEND",
      "startMs": 87500,
      "endMs": 91200,
      "content": "서울 근처에 있는 숙소를 찾아보고 선택지만 보내줄게."
    },
    {
      "segmentId": 27,
      "speakerRole": "SELF",
      "startMs": 91900,
      "endMs": 93800,
      "content": "근데 배고프다"
    },
    {
      "segmentId": 28,
      "speakerRole": "FRIEND",
      "startMs": 94500,
      "endMs": 97200,
      "content": "갑자기? 오늘 점심을 제대로 못 먹었어?"
    },
    {
      "segmentId": 29,
      "speakerRole": "SELF",
      "startMs": 97900,
      "endMs": 100000,
      "content": "먹었는데 그냥 뭐"
    },
    {
      "segmentId": 30,
      "speakerRole": "FRIEND",
      "startMs": 100700,
      "endMs": 104600,
      "content": "나는 오늘 회사 근처에 새로 생긴 국밥집에 갔어."
    },
    {
      "segmentId": 31,
      "speakerRole": "SELF",
      "startMs": 105300,
      "endMs": 106900,
      "content": "그래서"
    },
    {
      "segmentId": 32,
      "speakerRole": "FRIEND",
      "startMs": 107600,
      "endMs": 112000,
      "content": "생각보다 괜찮았어. 고기가 많았고 국물도 자극적이지 않았어."
    },
    {
      "segmentId": 33,
      "speakerRole": "SELF",
      "startMs": 112700,
      "endMs": 114400,
      "content": "아 그래"
    },
    {
      "segmentId": 34,
      "speakerRole": "FRIEND",
      "startMs": 115100,
      "endMs": 119000,
      "content": "다음에 회사 근처로 오면 같이 가도 좋을 것 같아."
    },
    {
      "segmentId": 35,
      "speakerRole": "SELF",
      "startMs": 119700,
      "endMs": 122100,
      "content": "근데 거기 그거 있냐"
    },
    {
      "segmentId": 36,
      "speakerRole": "FRIEND",
      "startMs": 122800,
      "endMs": 125700,
      "content": "그거라고 하면 뭘 말하는 건지 잘 모르겠어."
    },
    {
      "segmentId": 37,
      "speakerRole": "SELF",
      "startMs": 126400,
      "endMs": 128900,
      "content": "그 있잖아 그거 고기 그"
    },
    {
      "segmentId": 38,
      "speakerRole": "FRIEND",
      "startMs": 129600,
      "endMs": 133100,
      "content": "수육을 말하는 거라면 메뉴에 있었어."
    },
    {
      "segmentId": 39,
      "speakerRole": "SELF",
      "startMs": 133800,
      "endMs": 135600,
      "content": "아무튼 그거"
    },
    {
      "segmentId": 40,
      "speakerRole": "FRIEND",
      "startMs": 136300,
      "endMs": 139500,
      "content": "응, 수육도 있었고 양도 많아 보였어."
    },
    {
      "segmentId": 41,
      "speakerRole": "SELF",
      "startMs": 140200,
      "endMs": 142800,
      "content": "근데 내가 아까 말했나 그"
    },
    {
      "segmentId": 42,
      "speakerRole": "FRIEND",
      "startMs": 143500,
      "endMs": 146500,
      "content": "여행 일정에 대해서는 아직 정확하게 말하지 않았어."
    },
    {
      "segmentId": 43,
      "speakerRole": "SELF",
      "startMs": 147200,
      "endMs": 149400,
      "content": "아 그래 아무튼"
    },
    {
      "segmentId": 44,
      "speakerRole": "FRIEND",
      "startMs": 150100,
      "endMs": 154100,
      "content": "오늘 회사 일정을 확인한 다음 가능한 출발 시간을 보내줘."
    },
    {
      "segmentId": 45,
      "speakerRole": "SELF",
      "startMs": 154800,
      "endMs": 156500,
      "content": "응 할게"
    },
    {
      "segmentId": 46,
      "speakerRole": "FRIEND",
      "startMs": 157200,
      "endMs": 160900,
      "content": "확인하면 금요일과 토요일 중 어느 날이 좋은지도 같이 알려줘."
    },
    {
      "segmentId": 47,
      "speakerRole": "SELF",
      "startMs": 161600,
      "endMs": 163700,
      "content": "근데 그게 또"
    },
    {
      "segmentId": 48,
      "speakerRole": "FRIEND",
      "startMs": 164400,
      "endMs": 168600,
      "content": "지금 결정하기 어렵다면 가능한 일정만 보내줘. 나머지는 같이 정하면 돼."
    },
    {
      "segmentId": 49,
      "speakerRole": "SELF",
      "startMs": 169300,
      "endMs": 171300,
      "content": "어 알겠어 뭐"
    },
    {
      "segmentId": 50,
      "speakerRole": "FRIEND",
      "startMs": 172000,
      "endMs": 175700,
      "content": "응, 확인되면 연락해 줘. 급하게 정할 필요는 없어."
    }
  ]
}