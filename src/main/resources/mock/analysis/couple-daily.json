{
  "recordingId": 1002,
  "scenario": "COUPLE_DAILY",
  "durationMs": 660000,
  "speakers": [
    {"speakerRole": "SELF", "speakerName": "지민"},
    {"speakerRole": "PARTNER", "speakerName": "서연"}
  ],
  "segments": [
    {"segmentId": 1, "speakerRole": "SELF", "startMs": 1000, "endMs": 6500, "content": "오늘 목소리가 좀 피곤해 보이는데 회사에서 무슨 일 있었어?"},
    {"segmentId": 2, "speakerRole": "PARTNER", "startMs": 7000, "endMs": 13500, "content": "오후에 갑자기 회의가 두 개나 잡혀서 정신이 없었어."},
    {"segmentId": 3, "speakerRole": "SELF", "startMs": 14000, "endMs": 19000, "content": "점심은 먹었어? 바쁘면 또 대충 넘겼을 것 같은데."},
    {"segmentId": 4, "speakerRole": "PARTNER", "startMs": 19500, "endMs": 24500, "content": "샌드위치 하나 먹었어. 그래도 아예 안 먹은 건 아니야."},
    {"segmentId": 5, "speakerRole": "SELF", "startMs": 25000, "endMs": 30500, "content": "다행이네. 저녁에는 따뜻한 거 먹자. 내가 국 끓여줄게."},
    {"segmentId": 6, "speakerRole": "PARTNER", "startMs": 31000, "endMs": 35500, "content": "진짜? 그러면 집 가는 길에 두부 사 갈게."},
    {"segmentId": 7, "speakerRole": "SELF", "startMs": 36000, "endMs": 41500, "content": "좋아. 그리고 이번 주말에 한강 가기로 한 거 기억하지?"},
    {"segmentId": 8, "speakerRole": "PARTNER", "startMs": 42000, "endMs": 47500, "content": "기억하지. 비만 안 오면 돗자리 들고 가자."},
    {"segmentId": 9, "speakerRole": "SELF", "startMs": 48000, "endMs": 53000, "content": "도시락은 내가 준비할까? 네가 좋아하는 유부초밥으로."},
    {"segmentId": 10, "speakerRole": "PARTNER", "startMs": 53500, "endMs": 59000, "content": "그러면 나는 과일이랑 음료 챙길게. 너무 많이 준비하지는 마."},
    {"segmentId": 11, "speakerRole": "SELF", "startMs": 59500, "endMs": 64000, "content": "알겠어. 둘이 먹을 만큼만 준비할게."},
    {"segmentId": 12, "speakerRole": "PARTNER", "startMs": 64500, "endMs": 69500, "content": "요즘 바빠서 제대로 못 봤는데 주말에는 오래 같이 있고 싶어."},
    {"segmentId": 13, "speakerRole": "SELF", "startMs": 70000, "endMs": 74500, "content": "나도 보고 싶었어. 이번 주는 유난히 길게 느껴졌어."},
    {"segmentId": 14, "speakerRole": "PARTNER", "startMs": 75000, "endMs": 80000, "content": "토요일에는 업무 연락 와도 잠깐만 확인하고 넣어둘게."},
    {"segmentId": 15, "speakerRole": "SELF", "startMs": 80500, "endMs": 85500, "content": "무리해서 완전히 끊지는 말고 급한 것만 봐."},
    {"segmentId": 16, "speakerRole": "PARTNER", "startMs": 86000, "endMs": 91000, "content": "응, 대신 너도 사진 찍느라 산책을 놓치면 안 돼."},
    {"segmentId": 17, "speakerRole": "SELF", "startMs": 91500, "endMs": 96000, "content": "사진은 열 장만 찍고 같이 걸을게."},
    {"segmentId": 18, "speakerRole": "PARTNER", "startMs": 96500, "endMs": 101500, "content": "열 장이라고 말한 사람 중에 열 장만 찍는 사람은 못 봤는데."},
    {"segmentId": 19, "speakerRole": "SELF", "startMs": 105000, "endMs": 116000, "content": "이번에는 진짜 약속할게. 사진보다 너랑 쉬는 게 더 중요하니까."},
    {"segmentId": 20, "speakerRole": "PARTNER", "startMs": 118000, "endMs": 129000, "content": "그 말은 마음에 든다. 대신 마음에 드는 풍경이 있으면 같이 한 장은 찍자."},
    {"segmentId": 21, "speakerRole": "SELF", "startMs": 131000, "endMs": 142000, "content": "좋아. 삼각대 챙겨서 오랜만에 둘이 찍은 사진도 남기자."},
    {"segmentId": 22, "speakerRole": "PARTNER", "startMs": 144000, "endMs": 155000, "content": "우리 마지막으로 같이 찍은 게 겨울 바다 갔을 때였나?"},
    {"segmentId": 23, "speakerRole": "SELF", "startMs": 157000, "endMs": 168000, "content": "응, 바람 너무 불어서 둘 다 눈도 제대로 못 뜬 사진 말이지."},
    {"segmentId": 24, "speakerRole": "PARTNER", "startMs": 170000, "endMs": 181000, "content": "그래도 나는 그 사진 좋아해. 표정이 웃겨서 볼 때마다 기분이 좋아져."},
    {"segmentId": 25, "speakerRole": "SELF", "startMs": 183000, "endMs": 194000, "content": "나도 싫지는 않아. 네가 내 목도리까지 둘러준 게 기억나서 좋아."},
    {"segmentId": 26, "speakerRole": "PARTNER", "startMs": 196000, "endMs": 207000, "content": "네가 춥다고 계속 떨었잖아. 다음에는 옷을 제대로 챙겨 입어."},
    {"segmentId": 27, "speakerRole": "SELF", "startMs": 209000, "endMs": 220000, "content": "이번 주말은 따뜻하다니까 얇은 겉옷 하나만 가져가면 될 것 같아."},
    {"segmentId": 28, "speakerRole": "PARTNER", "startMs": 222000, "endMs": 233000, "content": "저녁에는 쌀쌀할 수 있으니까 내 가방에 바람막이 하나 더 넣을게."},
    {"segmentId": 29, "speakerRole": "SELF", "startMs": 237000, "endMs": 248000, "content": "오늘 저녁 국은 된장국이랑 미역국 중에 뭐가 더 당겨?"},
    {"segmentId": 30, "speakerRole": "PARTNER", "startMs": 250000, "endMs": 261000, "content": "된장국이 좋아. 냉장고에 애호박 남아 있었던 것 같은데."},
    {"segmentId": 31, "speakerRole": "SELF", "startMs": 263000, "endMs": 274000, "content": "맞아, 애호박이랑 버섯 있어. 두부만 사 오면 바로 끓일 수 있어."},
    {"segmentId": 32, "speakerRole": "PARTNER", "startMs": 276000, "endMs": 287000, "content": "밥은 내가 도착해서 할게. 너는 먼저 씻고 조금 쉬고 있어."},
    {"segmentId": 33, "speakerRole": "SELF", "startMs": 289000, "endMs": 300000, "content": "오늘 더 피곤한 사람은 너인데 나보고 쉬라고 하네."},
    {"segmentId": 34, "speakerRole": "PARTNER", "startMs": 302000, "endMs": 313000, "content": "나는 밥솥 버튼만 누르면 되잖아. 국 끓이는 사람이 더 많이 움직이지."},
    {"segmentId": 35, "speakerRole": "SELF", "startMs": 315000, "endMs": 326000, "content": "그럼 설거지는 내일 아침으로 미루지 말고 먹고 같이 하자."},
    {"segmentId": 36, "speakerRole": "PARTNER", "startMs": 328000, "endMs": 339000, "content": "좋아. 요즘 네가 혼자 설거지하게 두지 않으려고 신경 쓰고 있어."},
    {"segmentId": 37, "speakerRole": "SELF", "startMs": 341000, "endMs": 352000, "content": "알아. 지난주에도 내가 말하기 전에 먼저 해줘서 고마웠어."},
    {"segmentId": 38, "speakerRole": "PARTNER", "startMs": 354000, "endMs": 365000, "content": "그동안 네가 더 많이 했으니까 이제 비슷하게 나눠야지."},
    {"segmentId": 39, "speakerRole": "SELF", "startMs": 369000, "endMs": 380000, "content": "회의 두 개는 어떤 내용이었어? 다음 달 프로젝트 때문이야?"},
    {"segmentId": 40, "speakerRole": "PARTNER", "startMs": 382000, "endMs": 394000, "content": "응, 일정이 당겨질 수도 있어서 업무를 다시 나누는 회의였어."},
    {"segmentId": 41, "speakerRole": "SELF", "startMs": 396000, "endMs": 407000, "content": "혹시 네 몫이 너무 많아진 건 아니야? 아까 목소리가 많이 지쳐 보였어."},
    {"segmentId": 42, "speakerRole": "PARTNER", "startMs": 409000, "endMs": 421000, "content": "처음에는 걱정했는데 팀원이 하나씩 가져가서 감당할 정도로 정리됐어."},
    {"segmentId": 43, "speakerRole": "SELF", "startMs": 423000, "endMs": 434000, "content": "다행이다. 그래도 다음 주까지 야근이 계속되면 몸부터 챙겨."},
    {"segmentId": 44, "speakerRole": "PARTNER", "startMs": 436000, "endMs": 447000, "content": "응. 네가 이렇게 물어봐 주니까 회사 생각도 조금 내려놓게 된다."},
    {"segmentId": 45, "speakerRole": "SELF", "startMs": 449000, "endMs": 460000, "content": "힘든 날에는 해결책 없어도 그냥 말해줘. 듣는 건 잘할 수 있어."},
    {"segmentId": 46, "speakerRole": "PARTNER", "startMs": 462000, "endMs": 473000, "content": "알겠어. 오늘은 조언보다 수고했다고 한 번만 말해주면 좋겠어."},
    {"segmentId": 47, "speakerRole": "SELF", "startMs": 475000, "endMs": 486000, "content": "오늘 정말 수고 많았어. 혼자 참지 않고 말해줘서도 고마워."},
    {"segmentId": 48, "speakerRole": "PARTNER", "startMs": 488000, "endMs": 499000, "content": "이제 좀 살 것 같다. 집에 가서 따뜻한 밥 먹으면 완전히 괜찮아질 것 같아."},
    {"segmentId": 49, "speakerRole": "SELF", "startMs": 503000, "endMs": 514000, "content": "한강 갈 때 읽을 책도 가져갈까? 지난번에 같이 산 책 아직 못 읽었잖아."},
    {"segmentId": 50, "speakerRole": "PARTNER", "startMs": 516000, "endMs": 527000, "content": "좋아. 각자 조금 읽다가 재미있는 부분만 서로 얘기해주자."},
    {"segmentId": 51, "speakerRole": "SELF", "startMs": 529000, "endMs": 540000, "content": "그리고 해 질 때쯤 자전거도 탈래? 너무 오래 말고 삼십 분 정도."},
    {"segmentId": 52, "speakerRole": "PARTNER", "startMs": 542000, "endMs": 553000, "content": "사람이 너무 많지 않으면 좋아. 넘어질까 봐 빠르게는 못 타지만."},
    {"segmentId": 53, "speakerRole": "SELF", "startMs": 555000, "endMs": 566000, "content": "내가 옆에서 천천히 갈게. 속도 맞추면 되니까 걱정하지 마."},
    {"segmentId": 54, "speakerRole": "PARTNER", "startMs": 568000, "endMs": 579000, "content": "그러면 타볼래. 예전에 네가 먼저 가버려서 길 잃을 뻔한 건 기억하고 있어."},
    {"segmentId": 55, "speakerRole": "SELF", "startMs": 581000, "endMs": 592000, "content": "그때는 정말 미안했어. 이번에는 절대 혼자 앞서가지 않을게."},
    {"segmentId": 56, "speakerRole": "PARTNER", "startMs": 594000, "endMs": 605000, "content": "알겠어. 이번에는 믿어볼게. 대신 간식은 내가 고른다."},
    {"segmentId": 57, "speakerRole": "SELF", "startMs": 607000, "endMs": 618000, "content": "좋아. 유부초밥, 과일, 네가 고른 간식이면 충분하겠다."},
    {"segmentId": 58, "speakerRole": "PARTNER", "startMs": 620000, "endMs": 631000, "content": "벌써 주말이 기다려진다. 이번 주 남은 이틀만 잘 버텨보자."},
    {"segmentId": 59, "speakerRole": "SELF", "startMs": 633000, "endMs": 644000, "content": "응. 오늘은 내가 먼저 집에 가서 국 끓이고 기다리고 있을게."},
    {"segmentId": 60, "speakerRole": "PARTNER", "startMs": 646000, "endMs": 657000, "content": "고마워. 나도 두부 사서 바로 갈게. 집에서 보자."}
  ]
}
