# 운영 환경변수 예시
# 서버에서 이 파일을 deploy/.env.prod 로 복사한 뒤 실제 값을 채운다. (.env.prod는 gitignore 처리됨)
#   cp deploy/.env.prod.example deploy/.env.prod && chmod 600 deploy/.env.prod
#
# 랜덤 값 만들기: openssl rand -base64 48

# ---------- 도메인 · HTTPS ----------
API_DOMAIN=api.resay.site
# 인증서 만료 알림을 받을 이메일
ACME_EMAIL=

# ---------- DB ----------
# MYSQL_USER로도 쓰이므로 root는 안 된다
DB_USERNAME=resay
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ---------- JWT ----------
# 32바이트 이상. 로컬 값과 절대 같게 쓰지 않는다
JWT_SECRET=

# ---------- CORS ----------
# 프론트 운영 주소 (쉼표로 여러 개). 비어 있으면 서버가 뜨지 않는다
CORS_ALLOWED_ORIGINS=https://resay.site

# ---------- 카카오 로그인 ----------
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 카카오 콘솔에 등록된 값과 정확히 같아야 한다
KAKAO_ALLOWED_REDIRECT_URIS=https://resay.site/oauth/kakao/callback

# ---------- 구글 로그인 ----------
# 프론트가 구글 콘솔에서 발급한 Client ID (프론트와 같은 값). Client Secret은 필요 없다
GOOGLE_CLIENT_ID=

# ---------- 외부 연동 (B·C 담당) ----------
CLOVA_SPEECH_INVOKE_URL=
CLOVA_SPEECH_SECRET_KEY=
OPENAI_API_KEY=

# ---------- 런칭 전 테스트 기간에만 ----------
# 운영 프로필 기본값은 validate라 테이블이 없으면 서버가 뜨지 않는다.
# 런칭 전에는 update로 테이블을 자동 생성하고, 런칭 직전 Flyway 도입 시 이 줄을 지운다.
SPRING_JPA_HIBERNATE_DDL_AUTO=update
# 프론트 연동 기간에만 Swagger를 켠다. 런칭 시 이 줄을 지운다
SWAGGER_ENABLED=true

# ---------- 운영 알림 (선택) ----------
# 디스크 사용량 경고를 보낼 디스코드 웹훅 주소. 비워두면 로그만 남긴다
DISK_ALERT_WEBHOOK_URL=
