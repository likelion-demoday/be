# 운영 환경변수 예시
# 앱 컨테이너에는 docker-compose.prod.yml 의 app.environment 에 적힌 이름만 전달된다.
# 여기에 새 값을 추가했다면 그 목록에도 이름을 추가해야 앱이 읽을 수 있다.
# 서버에서 이 파일을 deploy/.env.prod 로 복사한 뒤 실제 값을 채운다. (.env.prod는 gitignore 처리됨)
#   cp deploy/.env.prod.example deploy/.env.prod && chmod 600 deploy/.env.prod
#
# 랜덤 값 만들기: openssl rand -base64 48

# ---------- 도메인 · HTTPS ----------
API_DOMAIN=api.resay.site

# ---------- DB ----------
# MYSQL_USER로도 쓰이므로 root는 안 된다
DB_USERNAME=resay
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ---------- JWT ----------
# 32바이트 이상. 로컬 값과 절대 같게 쓰지 않는다
JWT_SECRET=

# ---------- CORS ----------
# 프론트 운영 주소 (쉼표로 여러 개). 비어 있으면 서버가 뜨지 않는다
CORS_ALLOWED_ORIGINS=https://resay.site

# ---------- 카카오 로그인 ----------
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 카카오 콘솔에 등록된 값과 정확히 같아야 한다
KAKAO_ALLOWED_REDIRECT_URIS=https://resay.site/oauth/kakao/callback

# ---------- 구글 로그인 ----------
# 프론트가 구글 콘솔에서 발급한 Client ID (프론트와 같은 값). Client Secret은 필요 없다
GOOGLE_CLIENT_ID=

# ---------- 외부 연동 (B·C 담당) ----------
CLOVA_SPEECH_INVOKE_URL=
CLOVA_SPEECH_SECRET_KEY=
CLOVA_SPEECH_CALLBACK_BASE_URL=https://api.resay.site/api/v1/transcriptions/callback
LINER_API_KEY=
OPENAI_API_KEY=

# ---------- 나이스페이 (크레딧 충전) ----------
# 가맹점 관리자 > 개발정보의 클라이언트 키 · 시크릿 키. 반드시 Server 승인 / Basic 인증으로 발급한 것이어야 한다
#   클라이언트 키가 S2_(테스트 상점) 또는 R2_(운영 상점)로 시작한다. S1_ · R1_(Client 승인)이면 충전 주문을 받지 않는다
# 운영 상점 키를 넣으면 운영 주소로, 테스트 상점 키를 넣으면 샌드박스로 자동 연결된다. 두 키는 같은 상점 것이어야 한다
# 어느 쪽으로 연결됐는지는 서버가 뜰 때 로그의 "나이스페이 연동" 줄에서 확인한다
NICEPAY_CLIENT_KEY=
NICEPAY_SECRET_KEY=
# 아래는 기본값과 다르게 쓸 때만 주석을 풀고 지정한다. 값을 비운 채(이름=)로 두면 충전이 꺼지거나 서버가 뜨지 않으니 쓰지 않을 때는 주석으로 둔다
# 자동으로 고른 API 주소가 맞지 않을 때
# NICEPAY_API_BASE_URL=https://api.nicepay.co.kr
# 결제창이 인증 결과를 보내는 주소 (기본값: https://api.resay.site/api/v1/payments/nicepay/return)
# NICEPAY_RETURN_URL=
# 테스트 상점 키가 들어 있는 동안에는 운영자(ADMIN)만 충전할 수 있다. 모든 가입자에게 테스트 결제를 열려면 false
# PAYMENT_SANDBOX_ADMIN_ONLY=false

# ---------- 런칭 전 테스트 기간에만 ----------
# 운영 프로필 기본값은 validate라 테이블이 없으면 서버가 뜨지 않는다.
# 런칭 전에는 update로 테이블을 자동 생성하고, 런칭 직전 Flyway 도입 시 이 줄을 지운다.
SPRING_JPA_HIBERNATE_DDL_AUTO=update
# 프론트 연동 기간에만 Swagger를 켠다. 런칭 시 이 줄을 지운다
SWAGGER_ENABLED=true

# ---------- 비상용 ----------
# 로그인 · 가입 시도 횟수 제한은 기본으로 켜져 있다. 정상 사용자가 막히는 문제가 생겼을 때만 아래 줄의 주석을 풀고 재배포한다.
# 값을 비운 채(RATE_LIMIT_ENABLED=)로 두면 서버가 뜨지 않으니, 쓰지 않을 때는 주석으로 둔다
# RATE_LIMIT_ENABLED=false

# ---------- 운영 알림 (선택) ----------
# 디스크 사용량 경고를 보낼 디스코드 웹훅 주소. 비워두면 로그만 남긴다
DISK_ALERT_WEBHOOK_URL=
