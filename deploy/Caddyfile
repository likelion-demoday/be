# Caddy가 Let's Encrypt 인증서를 자동으로 발급하고 만료 전에 갱신한다.
# 조건: API_DOMAIN의 DNS A 레코드가 이 서버 IP를 가리키고, 80·443 포트가 열려 있어야 한다.

{$API_DOMAIN} {
	encode gzip

	# 요청 본문 크기 제한
	# 음성 업로드만 큰 본문을 허용하고 나머지 API는 1MB로 제한한다.
	# 전체를 크게 열어두면 로그인 같은 공개 API에 수백 MB 본문을 동시에 보내 서버 메모리(2GB)를 고갈시킬 수 있다.
	# handle 블록은 하나만 실행되므로 두 제한이 겹쳐 적용되지 않는다.
	@upload {
		method POST
		path /api/v1/recordings /api/v1/recordings/
	}
	handle @upload {
		# 스프링 multipart 한도(210MB)와 맞춘다
		request_body {
			max_size 210MB
		}
		reverse_proxy app:8080
	}
	handle {
		request_body {
			max_size 1MB
		}
		reverse_proxy app:8080
	}

	log {
		output stdout
		format console
	}
}
