# Caddy가 Let's Encrypt 인증서를 자동으로 발급하고 만료 전에 갱신한다.
# 조건: API_DOMAIN의 DNS A 레코드가 이 서버 IP를 가리키고, 80·443 포트가 열려 있어야 한다.
{
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	encode gzip

	# 최대 30분 음성 업로드를 받기 위해 스프링 multipart 한도(210MB)와 맞춘다
	request_body {
		max_size 210MB
	}

	reverse_proxy app:8080

	log {
		output stdout
		format console
	}
}
