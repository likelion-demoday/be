# Caddy가 Let's Encrypt 인증서를 자동으로 발급하고 만료 전에 갱신한다.
# 조건: API_DOMAIN의 DNS A 레코드가 이 서버 IP를 가리키고, 80·443 포트가 열려 있어야 한다.
#
# 이 파일을 고쳐서 배포하면 deploy/deploy.sh 가 문법을 검사한 뒤 연결을 끊지 않고 반영한다.
# 컨테이너에는 이 폴더(deploy/caddy)를 통째로 연결한다. 파일 하나만 연결하면 파일이 교체돼도 컨테이너는 옛 내용을 계속 본다.
{
	# HTTP/3는 쓰지 않는다. UDP 443을 열지 않았는데 켜 두면, 브라우저가 연결되지 않는 주소를 안내받아 헛시도를 한다
	servers {
		protocols h1 h2
	}
}

{$API_DOMAIN} {
	encode gzip

	# 요청 본문 크기 제한
	# 음성 업로드만 큰 본문을 허용하고 나머지 API는 1MB로 제한한다.
	# 전체를 크게 열어두면 로그인 같은 공개 API에 수백 MB 본문을 동시에 보내 서버 메모리(2GB)를 고갈시킬 수 있다.
	# handle 블록은 하나만 실행되므로 두 제한이 겹쳐 적용되지 않는다.
	@upload {
		method POST
		path /api/v1/recordings /api/v1/recordings/
	}
	handle @upload {
		# 스프링의 파일 한도(200MB)에 multipart 여유분을 더한 값. Caddy의 MB는 1000 단위다 (210MB = 210,000,000바이트)
		request_body {
			max_size 210MB
		}
		reverse_proxy app:8080
	}
	handle {
		request_body {
			max_size 1MB
		}
		reverse_proxy app:8080
	}

	log {
		output stdout
		format console
	}
}
